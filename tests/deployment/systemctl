#!/usr/bin/env bash
# Container-only systemd stand-in: runs the real service binary and nginx.
set -euo pipefail
# Real systemd launches services independently of the caller’s open lock fd.
exec 9>&-
printf '%s\n' "$*" >> /tmp/systemctl-calls
command=$1; shift
case "$command" in
  daemon-reload|enable) exit 0 ;;
  is-active)
    name=${*: -1}
    if [[ $name == nginx ]]; then [[ -f /run/nginx.pid ]] && kill -0 "$(cat /run/nginx.pid)"; exit; fi
    [[ -f /tmp/receiver.pid ]] && kill -0 "$(cat /tmp/receiver.pid)"; exit ;;
  restart)
    [[ $1 == csptool-receiver ]]
    if [[ -f /tmp/receiver.pid ]]; then
      kill "$(cat /tmp/receiver.pid)" 2>/dev/null || true
      for _ in {1..20}; do kill -0 "$(cat /tmp/receiver.pid)" 2>/dev/null || break; sleep .1; done
    fi
    executable=$(sed -n 's/^ExecStart=\([^ ]*\).*/\1/p' /etc/systemd/system/csptool-receiver.service)
    set -a
    # This file is generated by the installer, not a credentials file.
    # shellcheck source=/dev/null
    source /etc/csptool-receiver/receiver.env
    set +a
    runuser -u csptool-receiver -- "$executable" /opt/csptool-receiver/current/server.js 9>&- > /tmp/receiver.log 2>&1 &
    echo $! > /tmp/receiver.pid ;;
  start)
    if [[ $1 == nginx ]]; then
      if [[ ! -s /run/nginx.pid ]] || ! kill -0 "$(cat /run/nginx.pid)" 2>/dev/null; then /usr/sbin/nginx; fi
    fi ;;
  reload) [[ $1 == nginx ]]; /usr/sbin/nginx -s reload ;;
  disable|stop)
    if [[ -f /tmp/receiver.pid ]]; then kill "$(cat /tmp/receiver.pid)" 2>/dev/null || true; rm -f /tmp/receiver.pid; fi ;;
  *) echo "Unexpected systemctl invocation: $command $*" >&2; exit 1 ;;
esac
